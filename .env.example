# PayPal Sandbox Credentials (from https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Gemini API Credentials (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Mandate Guard HMAC Signing Secret (random 32+ characters)
MANDATE_SIGNING_SECRET=mandate-guard-signing-secret-key-32chars-min

# Application URLs
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./mandate_guard.db
